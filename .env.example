# NVIDIA NIM API key for Nemotron (required for LLM reasoning nodes;
# without it, agents fall back to deterministic heuristics)
NVIDIA_API_KEY=your-nvidia-api-key

# Optional overrides
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# S2_API_KEY=your-semantic-scholar-key
# DATASENTINEL_DB=./datasentinel.db

# Kaggle API — enables REAL dataset downloads + profiling
# Preferred: token (https://www.kaggle.com/settings -> API -> Create New Token)
# KAGGLE_API_TOKEN=KGAT_xxxxxxxx
# Legacy alternative:
# KAGGLE_USERNAME=your-username
# KAGGLE_KEY=your-key
